# Variables para ejecutar todo el sistema en local con docker compose.
# Copia este archivo a .env (git lo ignora) y cambia los valores si quieres:
#   cp .env.example .env
# Las contraseñas solo pueden llevar caracteres seguros para URL (letras, números, guion y guion bajo).

PRODUCTS_DB_PASSWORD=change-me-products
ORDERS_DB_PASSWORD=change-me-orders

# Puerto del host donde se publica el frontend (por defecto 80)
FRONTEND_PORT=80

# Versiones que se muestran en el pie de página (por defecto dev)
FRONTEND_APP_VERSION=dev
PRODUCTS_APP_VERSION=dev
ORDERS_APP_VERSION=dev
