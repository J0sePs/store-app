# Copia este archivo a terraform.tfvars (git lo ignora) y ajusta los valores.
#   cp terraform.tfvars.example terraform.tfvars

region       = "us-east-1"
cluster_name = "store-eks"

# Obligatorio: tu usuario u organización de GitHub (dueño de store-app)
github_owner = "your-github-user"

# Recomendado: limita el endpoint público del clúster a tu IP
# cluster_endpoint_public_access_cidrs = ["203.0.113.4/32"]

# Pon false si tu cuenta de AWS ya tiene el proveedor OIDC de GitHub
# create_github_oidc_provider = false

# Tipo de nodos: por defecto t3.small, el que permite el plan Gratuito de AWS (2 nodos, 11 pods cada uno).
# Solo en una cuenta de pago puedes usar nodos más grandes:
# node_instance_types = ["t3.medium"]

# Ids numéricos de GitHub (dueño y repositorio). Obligatorios si el repositorio usa el sujeto inmutable
# (compruébalo con: gh api repos/<dueño>/<repo>/actions/oidc/customization/sub  -> use_immutable_subject: true).
# Se obtienen con: gh api repos/<dueño>/<repo> --jq '.id, .owner.id'   (primero el id del repositorio y luego el del dueño)
# Define los dos o ninguno. Sin ellos se usa el formato antiguo del sub: repo:<dueño>/<repo>:ref:refs/heads/<rama>
# github_owner_id      = 123456789
# github_repository_id = 987654321
